# Whitelist: ignore everything in the root, then allow only what is published.
# Notebooks, scripts, figures and raw results (results/, param_space/, gap/, ...)
# stay local.
/*

!/.gitignore
!/README.md
!/diploma.pdf
!/ppt.pdf
!/lib/

# Build and packaging artifacts
/lib/build/
/lib/dist/
**/*.egg-info/

# Python caches
**/__pycache__/
**/*.py[cod]

# OS / editor junk
**/.DS_Store
**/.ipynb_checkpoints/
